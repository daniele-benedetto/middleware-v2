{
  "name": "middleware-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true pnpm build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:infra:up": "docker compose up -d postgres redis minio minio-init",
    "docker:infra:down": "docker compose down",
    "docker:infra:logs": "docker compose logs -f postgres redis minio minio-init",
    "docker:analytics:up": "docker compose --env-file .env.analytics -f compose.analytics.yml up -d",
    "docker:analytics:down": "docker compose --env-file .env.analytics -f compose.analytics.yml down",
    "docker:analytics:logs": "docker compose --env-file .env.analytics -f compose.analytics.yml logs -f umami umami-postgres",
    "deploy:production": "scripts/production-deploy-manual.sh --execute",
    "deploy:production:dry-run": "scripts/production-deploy-manual.sh --dry-run",
    "fix:tailwind-vars": "node scripts/fix-tailwind-color-vars.mjs",
    "fix:tailwind-vars:check": "node scripts/fix-tailwind-color-vars.mjs --check",
    "fix:all": "pnpm fix:tailwind-vars && pnpm format && pnpm lint:fix",
    "auth:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "seed:articles": "node scripts/create-first-issue.mjs",
    "audit:prune": "node scripts/prune-audit-logs.mjs",
    "check:all": "pnpm fix:tailwind-vars:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm prisma:validate && pnpm build",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "node scripts/fix-tailwind-color-vars.mjs",
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "*.prisma": [
      "prisma format"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.7.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@smithy/node-http-handler": "4.9.1",
    "@tanstack/react-query": "^5.101.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/leaflet": "^1.9.22",
    "@vivliostyle/core": "^2.45.2",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "hyphen": "^1.14.1",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "recharts": "3.8.0",
    "redis": "^5.12.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.4",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "prisma": "^7.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.9",
      "hono": "4.13.16",
      "nanoid": "3.3.20",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.35",
      "source-map-js": "1.2.2",
      "minimatch@3.1.5>brace-expansion": "1.1.21",
      "minimatch@10.2.5>brace-expansion": "5.0.12",
      "js-yaml": "4.3.2",
      "systeminformation": "5.33.16",
      "ip-address": "10.7.5",
      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "valibot": "1.4.2",
      "vite": "8.3.5"
    }
  }
}

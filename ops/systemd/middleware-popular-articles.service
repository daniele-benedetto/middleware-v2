[Unit]
Description=Synchronize popular articles from Umami
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/middleware
ExecStart=/opt/middleware/bin/sync-popular-articles.sh
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true

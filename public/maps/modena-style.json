{
  "version": 8,
  "name": "Middleware Modena",
  "sources": {
    "modena": {
      "type": "vector",
      "tiles": ["/tiles/data/modena/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "OpenStreetMap contributors, Geofabrik GmbH"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f7f0e7" }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "modena",
      "source-layer": "land",
      "paint": { "fill-color": "#e7dfd5", "fill-opacity": 0.7 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "modena",
      "source-layer": "water_polygons",
      "paint": { "fill-color": "#b7cbd8", "fill-opacity": 0.9 }
    },
    {
      "id": "streets",
      "type": "fill",
      "source": "modena",
      "source-layer": "street_polygons",
      "paint": { "fill-color": "#f7f0e7", "fill-outline-color": "#c3b9ad" }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "modena",
      "source-layer": "buildings",
      "paint": { "fill-color": "#d2c7ba", "fill-opacity": 0.7 }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "modena",
      "source-layer": "boundaries",
      "paint": { "line-color": "#000000", "line-width": 1 }
    }
  ]
}
